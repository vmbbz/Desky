{
  admin off
}

{$DESKY_HERMES_HOST} {
  encode zstd gzip

  request_body {
    max_size 2MB
  }

  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "no-referrer"
    -Server
  }

  reverse_proxy 127.0.0.1:8642 {
    flush_interval -1
  }
}
