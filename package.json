{
  "name": "desky",
  "productName": "Deskii",
  "version": "0.1.0",
  "description": "An expressive desktop companion for the AI agent you already use.",
  "main": ".webpack/main",
  "private": true,
  "license": "SEE LICENSE IN LICENSE.md",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "start": "electron-forge start",
    "build:animation-converter": "webpack --config webpack.animation-converter.config.mjs",
    "animation:converter": "npm run build:animation-converter --silent && node out/tools/desky-animation-converter.cjs",
    "package": "electron-forge package",
    "package:windows:direct": "node scripts/package-release-profile.mjs windows-direct",
    "package:windows:store-free": "node scripts/package-release-profile.mjs windows-store-free",
    "package:macos:direct": "node scripts/package-release-profile.mjs macos-direct",
    "package:macos:store": "node scripts/package-release-profile.mjs macos-store",
    "make:windows:direct": "node scripts/make-release-profile.mjs windows-direct",
    "make:windows:direct:dev": "node scripts/make-release-profile.mjs windows-direct --development",
    "make:windows:store-free": "node scripts/make-release-profile.mjs windows-store-free",
    "make:windows:store-free:dev": "node scripts/make-release-profile.mjs windows-store-free --development",
    "package:claude:admission": "node scripts/package-claude-admission.mjs",
    "make": "electron-forge make",
    "release:evidence": "node scripts/generate-release-evidence.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:openclaw:live": "vitest run tests/openclaw-live.test.ts",
    "test:codex:live": "vitest run tests/codex-live.test.ts",
    "test:codex:matrix:live": "node scripts/run-codex-live-matrix.mjs",
    "test:hermes:live": "vitest run tests/hermes-live.test.ts",
    "test:hermes:matrix:live": "node scripts/run-hermes-live-matrix.mjs",
    "codex:schema:verify": "node scripts/verify-codex-schema.mjs",
    "codex:schema:refresh": "node scripts/verify-codex-schema.mjs --write-baseline",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.241",
    "@pixiv/three-vrm": "3.5.5",
    "@pixiv/three-vrm-animation": "3.5.5",
    "electron-squirrel-startup": "1.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "three": "0.185.1",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@cyclonedx/cyclonedx-npm": "6.0.1",
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-msix": "7.11.2",
    "@electron-forge/maker-squirrel": "7.11.2",
    "@electron-forge/maker-zip": "7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "7.11.2",
    "@electron-forge/plugin-fuses": "7.11.2",
    "@electron-forge/plugin-webpack": "7.11.2",
    "@electron/asar": "3.4.1",
    "@electron/fuses": "1.8.0",
    "@types/electron-squirrel-startup": "1.0.2",
    "@types/node": "22.15.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/three": "0.185.0",
    "@types/ws": "8.18.1",
    "@vercel/webpack-asset-relocator-loader": "1.7.3",
    "css-loader": "7.1.2",
    "electron": "43.4.1",
    "eslint": "10.0.0",
    "fork-ts-checker-webpack-plugin": "9.1.0",
    "node-loader": "2.1.0",
    "style-loader": "4.0.0",
    "ts-loader": "9.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.11",
    "webpack": "5.109.2",
    "webpack-cli": "6.0.1"
  }
}
